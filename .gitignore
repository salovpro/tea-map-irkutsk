# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# PWA
**/public/sw.js
**/public/workbox-*.js
**/public/sw.js.map
**/public/workbox-*.js.map
**/public/worker-*.js
**/public/worker-*.js.map
**/public/fallback-*.js

# misc
.DS_Store
*.pem

# local IDE / agent tooling
.agents/
.claude/
.cursor/
.windsurf/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local admin image uploads (legacy public fallback)
/public/uploads/

# Amvera / local persistent venue images
.local-storage/

# database migration backups (do not use a global *.sql)
/supabase-public.dump
/supabase-public.sql
/dump-list.txt
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
