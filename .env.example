# Copy this file to `.env` in the project root:
#   cp .env.example .env
#
# Prisma CLI and seed load `.env` via dotenv.
# Next.js also picks up `.env` / `.env.local`.

# Local Postgres (docker compose up -d). sslmode=disable is required:
# without it the pg driver tries TLS and local Postgres rejects the connection.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/irkmaptea?sslmode=disable"

# Optional. Defaults to a local code in src/lib/admin-auth.ts if unset.
# ADMIN_ACCESS_CODE="change-me"

# Optional. Stable admin session cookie value.
# ADMIN_SESSION_TOKEN=""

# Optional. Local venue image directory (defaults to .local-storage/venue-images).
# VENUE_STORAGE_PATH=""
